{
  "description": "Engineering principles at session/subagent start, and registry hash reminders after edits; advisory only. Runs via hooks/run-python.sh so python3 / python / py -3 all work (Windows included).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run-python.sh\" \"${CLAUDE_PLUGIN_ROOT}/skills/engineering-principles/scripts/inject_principles.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run-python.sh\" \"${CLAUDE_PLUGIN_ROOT}/skills/engineering-principles/scripts/inject_principles.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run-python.sh\" \"${CLAUDE_PLUGIN_ROOT}/skills/artifact-conventions/scripts/integrity_reminder.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
